<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#0f0a1e">
<title>Clean Arcade - Play Free Games</title>
<script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-firestore-compat.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#0f0a1e;color:#fff;min-height:100vh;-webkit-tap-highlight-color:transparent;overflow-x:hidden}
.blob{position:fixed;border-radius:50%;filter:blur(80px);pointer-events:none;z-index:0}
.b1{top:-128px;right:-128px;width:288px;height:288px;background:rgba(147,51,234,.08);animation:p 4s ease-in-out infinite}
.b2{bottom:-128px;left:-128px;width:288px;height:288px;background:rgba(37,99,235,.08);animation:p 4s ease-in-out infinite 1s}
.b3{top:33%;left:50%;transform:translateX(-50%);width:320px;height:320px;background:rgba(79,70,229,.05);animation:p 4s ease-in-out infinite 2s}
@keyframes p{0%,100%{opacity:1}50%{opacity:.5}}
@keyframes up{from{opacity:0;transform:translateY(30px) scale(.9)}to{opacity:1;transform:translateY(0) scale(1)}}
@keyframes fl{0%,100%{transform:translateY(0);opacity:.3}50%{transform:translateY(-12px);opacity:.6}}
@keyframes pi{0%{transform:scale(1);opacity:1}100%{transform:scale(2.5);opacity:0}}
.w{position:relative;z-index:1;max-width:448px;margin:0 auto;padding:32px 16px 48px}
header{text-align:center;margin-bottom:32px;animation:up .8s ease-out}
.logo{position:relative;display:inline-flex;margin-bottom:20px}
.lg{position:absolute;inset:0;background:linear-gradient(135deg,#a855f7,#6366f1);border-radius:16px;filter:blur(16px);opacity:.5;animation:p 3s ease-in-out infinite}
.lb{position:relative;width:72px;height:72px;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#a855f7,#6366f1);border-radius:16px;box-shadow:0 20px 40px rgba(168,85,247,.3)}
.lb span{font-size:36px}
h1{font-size:28px;font-weight:800;margin-bottom:4px}
.sub{color:#9ca3af;font-size:14px;margin-bottom:16px}
.badge{display:inline-flex;align-items:center;gap:8px;padding:6px 16px;border-radius:999px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1)}
.dot{width:8px;height:8px;border-radius:50%;background:#4ade80;position:relative}
.dot::after{content:'';position:absolute;inset:0;border-radius:50%;background:#4ade80;animation:pi 1.5s ease-out infinite}
.badge span{font-size:12px;color:#d1d5db;font-weight:500}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.card{border-radius:16px;overflow:hidden;border:1px solid rgba(255,255,255,.1);box-shadow:0 10px 30px rgba(0,0,0,.3);transition:transform .3s,box-shadow .3s;animation:up .6s ease-out backwards}
.card:hover{transform:translateY(-4px);box-shadow:0 20px 40px rgba(0,0,0,.4)}
.card:active{transform:scale(.97)}
.th{position:relative;aspect-ratio:4/3;display:flex;align-items:center;justify-content:center;overflow:hidden}
.em{font-size:56px;position:relative;z-index:2;filter:drop-shadow(0 4px 12px rgba(0,0,0,.4));transition:transform .4s}
.card:hover .em{transform:scale(1.15)}
.ov{position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.5),transparent 60%);z-index:1}
.bd{background:rgba(17,17,34,.9);padding:12px}
.tl{color:#fff;font-weight:700;font-size:14px;margin-bottom:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bt{width:100%;padding:10px 16px;background:linear-gradient(to right,#22c55e,#059669);color:#fff;font-weight:700;font-size:14px;border:none;border-radius:12px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;box-shadow:0 8px 20px rgba(34,197,94,.25);transition:all .2s;touch-action:manipulation}
.bt:hover{background:linear-gradient(to right,#4ade80,#10b981)}
.bt:active{transform:scale(.95)}
.bt svg{width:16px;height:16px}
footer{margin-top:40px;text-align:center;animation:up .8s ease-out .5s backwards}
.fb{display:inline-flex;padding:8px 16px;border-radius:999px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.06)}
.fb span{font-size:11px;color:#6b7280}
.pt{position:absolute;border-radius:50%;background:rgba(255,255,255,.1);animation:fl 3s ease-in-out infinite}
.ps{position:absolute;inset:0;width:100%;height:100%;opacity:.2}
.admin-btn{position:fixed;bottom:20px;right:20px;width:50px;height:50px;border-radius:50%;background:linear-gradient(135deg,#667eea,#764ba2);border:none;color:white;font-size:24px;cursor:pointer;box-shadow:0 4px 15px rgba(102,126,234,.4);z-index:50;transition:transform .2s}
.admin-btn:active{transform:scale(.9)}
.admin-overlay{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.95);z-index:100;display:none;align-items:center;justify-content:center;padding:20px;overflow-y:auto}
.admin-overlay.show{display:flex}
.admin-box{background:#1a1a2e;border-radius:20px;padding:25px;width:100%;max-width:500px;max-height:90vh;overflow-y:auto;border:2px solid #667eea}
.admin-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;padding-bottom:15px;border-bottom:1px solid rgba(255,255,255,.1)}
.admin-header h2{color:#ffd700;font-size:22px}
.admin-close{background:#ff4757;color:white;border:none;width:35px;height:35px;border-radius:50%;font-size:20px;cursor:pointer}
.admin-login{background:rgba(255,255,255,.05);padding:15px;border-radius:12px;margin-bottom:15px}
.admin-login input{width:100%;padding:12px;background:rgba(0,0,0,.3);border:1px solid rgba(255,255,255,.2);border-radius:8px;color:white;font-size:16px;margin-bottom:10px}
.admin-login button{width:100%;padding:12px;background:linear-gradient(135deg,#667eea,#764ba2);color:white;border:none;border-radius:8px;font-weight:bold;cursor:pointer}
.admin-stats{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:20px}
.stat-card{background:rgba(255,255,255,.05);padding:15px;border-radius:12px;text-align:center}
.stat-card .num{font-size:28px;font-weight:bold;color:#ffd700}
.stat-card .label{font-size:12px;color:#9ca3af;margin-top:5px}
.player-list{max-height:300px;overflow-y:auto}
.player-item{background:rgba(255,255,255,.05);padding:12px;border-radius:10px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center}
.player-info{flex:1}
.player-id{font-size:12px;color:#9ca3af;margin-bottom:3px}
.player-game{font-size:14px;color:#fff;font-weight:bold}
.player-status{padding:4px 10px;border-radius:12px;font-size:11px;font-weight:bold}
.status-online{background:#2ed573;color:white}
.status-offline{background:#747d8c;color:white}
</style>
</head>
<body>
<div class="blob b1"></div><div class="blob b2"></div><div class="blob b3"></div>
<div class="w">
<header>
<div class="logo"><div class="lg"></div><div class="lb"><span>🎮</span></div></div>
<h1>Clean Arcade</h1>
<p class="sub">Free games, no ads, pure fun!</p>
<div class="badge"><div class="dot"></div><span id="gc">0 games available</span></div>
</header>
<div class="grid" id="gg"></div>
<footer><div class="fb"><span>© 2026 Clean Arcade • No Ads</span></div></footer>
</div>

<button class="admin-btn" onclick="openAdmin()">⚙️</button>
<div class="admin-overlay" id="adminOverlay">
<div class="admin-box">
<div class="admin-header"><h2>🔐 Admin Panel</h2><button class="admin-close" onclick="closeAdmin()">✖</button></div>
<div id="adminLogin" class="admin-login"><input type="password" id="adminPass" placeholder="Masukkan password admin"><button onclick="loginAdmin()">Login</button></div>
<div id="adminContent" style="display:none">
<div class="admin-stats">
<div class="stat-card"><div class="num" id="totalPlayers">0</div><div class="label">Total Players</div></div>
<div class="stat-card"><div class="num" id="onlinePlayers">0</div><div class="label">Online Now</div></div>
<div class="stat-card"><div class="num" id="totalGames">0</div><div class="label">Total Games</div></div>
<div class="stat-card"><div class="num" id="todayVisits">0</div><div class="label">Today Visits</div></div>
</div>
<h3 style="color:#ffd700;margin-bottom:10px">👥 Player List</h3>
<div class="player-list" id="playerList"><p style="color:#9ca3af;text-align:center">Loading...</p></div>
</div></div></div>

<script>
const firebaseConfig = { apiKey: "AIzaSyBwI7yZZVyNmH_HLsKFE-jSaTfVApIVYcQ", authDomain: "hansorbblast.firebaseapp.com", projectId: "hansorbblast", storageBucket: "hansorbblast.firebasestorage.app", messagingSenderId: "562424899290", appId: "1:562424899290:web:75e0c912db1ada3341e7e3" };
firebase.initializeApp(firebaseConfig); const db = firebase.firestore();
const ADMIN_PASSWORD = "aruanscuan2024";

// ✅ DAFTAR GAME CLEAN - STAR ENEMY SUDAH MASUK DI SINI!
var G=[
{n:"Fusion Fruit",u:"/fusionfruit_clean.html",e:"🍉",g:"linear-gradient(135deg,#a8edea,#fed6e3)",p:"circles"},
{n:"Gold Brick",u:"/goldbrick_clean.html",e:"🧱",g:"linear-gradient(135deg,#f6d365,#fda085)",p:"grid"},
{n:"Hans Cut Fruit",u:"/hanscutfruit_clean.html",e:"🔪",g:"linear-gradient(135deg,#ff9a9e,#fad0c4)",p:"circles"},
{n:"Hans Orb Blast",u:"/hansorbbblast_clean.html",e:"🔵",g:"linear-gradient(135deg,#a8edea,#fed6e3)",p:"stars"},
{n:"Memory Cuan",u:"/memorycuan_clean.html",e:"🧠",g:"linear-gradient(135deg,#1e3c72,#2a5298)",p:"diamonds"},
{n:"Cocktail Cuan",u:"/cocktailcuan_clean.html",e:"🍹",g:"linear-gradient(135deg,#ff9a9e,#fad0c4)",p:"waves"},
{n:"Star Enemy",u:"/starenemy_clean.html",e:"",g:"linear-gradient(135deg,#0f0c29,#302b63)",p:"stars"},
{n:"Mach Fruits",u:"/machfruits_clean.html",e:"🍒",g:"linear-gradient(135deg,#ff9a9e,#fecfef)",p:"dots"}
];

var P={
circles:'<pattern id="p" width="40" height="40" patternUnits="userSpaceOnUse"><circle cx="20" cy="20" r="8" fill="white" opacity=".3"/><circle cx="20" cy="20" r="3" fill="white" opacity=".5"/></pattern>',
waves:'<pattern id="p" width="60" height="30" patternUnits="userSpaceOnUse"><path d="M0 15Q15 0 30 15Q45 30 60 15" fill="none" stroke="white" stroke-width="2"/></pattern>',
grid:'<pattern id="p" width="30" height="30" patternUnits="userSpaceOnUse"><rect width="30" height="30" fill="none" stroke="white" stroke-width="1" opacity=".4"/><rect x="5" y="5" width="20" height="20" fill="white" opacity=".1" rx="2"/></pattern>',
dots:'<pattern id="p" width="20" height="20" patternUnits="userSpaceOnUse"><circle cx="10" cy="10" r="2" fill="white" opacity=".5"/></pattern>',
diamonds:'<pattern id="p" width="30" height="30" patternUnits="userSpaceOnUse"><polygon points="15,2 28,15 15,28 2,15" fill="none" stroke="white" stroke-width="1.5" opacity=".4"/></pattern>',
stars:'<pattern id="p" width="40" height="40" patternUnits="userSpaceOnUse"><circle cx="5" cy="5" r="1" fill="white"/><circle cx="25" cy="15" r="1.5" fill="white"/><circle cx="35" cy="35" r="1" fill="white"/><circle cx="15" cy="30" r=".8" fill="white"/></pattern>'
};

function R(){
var g=document.getElementById('gg');
document.getElementById('gc').textContent=G.length+' games available';
g.innerHTML='';
G.forEach(function(v,i){
var c=document.createElement('div');c.className='card';c.style.animationDelay=i*.08+'s';
var h='<div class="th" style="background:'+v.g+'"><svg class="ps" xmlns="http://www.w3.org/2000/svg"><defs>'+(P[v.p]||P.circles)+'</defs><rect width="100%" height="100%" fill="url(#p)"/></svg>';
for(var j=0;j<4;j++){var s=4+Math.random()*5;h+='<div class="pt" style="width:'+s+'px;height:'+s+'px;left:'+(10+Math.random()*80)+'%;top:'+(10+Math.random()*80)+'%;animation-duration:'+(3+Math.random()*3)+'s;animation-delay:'+(Math.random()*2)+'s"></div>';}
h+='<div class="ov"></div><div class="em">'+v.e+'</div></div><div class="bd"><div class="tl">'+v.n+'</div><button class="bt" onclick="location.href=\''+v.u+'\'"><svg fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"/></svg>PLAY</button></div>';
c.innerHTML=h;g.appendChild(c);
});}
document.addEventListener('DOMContentLoaded',R);

let playerId = localStorage.getItem('clean_player_id');
if (!playerId) { playerId = 'player_' + Date.now() + '_' + Math.floor(Math.random() * 100000); localStorage.setItem('clean_player_id', playerId); }
db.collection('players').doc(playerId).set({ playerId: playerId, isOnline: true, lastVisit: firebase.firestore.FieldValue.serverTimestamp(), firstVisit: firebase.firestore.FieldValue.serverTimestamp(), game: 'CleanArcade', totalVisits: firebase.firestore.FieldValue.increment(1) }, { merge: true }).catch(err => console.log('Firebase error:', err));
window.addEventListener('beforeunload', () => { db.collection('players').doc(playerId).update({ isOnline: false }).catch(() => {}); });

function openAdmin() { document.getElementById('adminOverlay').classList.add('show'); }
function closeAdmin() { document.getElementById('adminOverlay').classList.remove('show'); document.getElementById('adminLogin').style.display = 'block'; document.getElementById('adminContent').style.display = 'none'; document.getElementById('adminPass').value = ''; }
function loginAdmin() { const pass = document.getElementById('adminPass').value; if (pass === ADMIN_PASSWORD) { document.getElementById('adminLogin').style.display = 'none'; document.getElementById('adminContent').style.display = 'block'; loadAdminData(); } else { alert(' Password salah!'); } }

function loadAdminData() {
    db.collection('players').get().then(snapshot => {
        let total = snapshot.size, online = 0, todayVisits = 0;
        const today = new Date(); today.setHours(0, 0, 0, 0);
        let playerList = [];
        snapshot.forEach(doc => {
            const data = doc.data();
            if (data.isOnline) online++;
            if (data.lastVisit && data.lastVisit.toDate) { if (data.lastVisit.toDate() >= today) todayVisits++; }
            playerList.push({ id: doc.id, ...data });
        });
        document.getElementById('totalPlayers').innerText = total;
        document.getElementById('onlinePlayers').innerText = online;
        document.getElementById('totalGames').innerText = G.length;
        document.getElementById('todayVisits').innerText = todayVisits;
        playerList.sort((a, b) => { if (a.lastVisit && b.lastVisit) return b.lastVisit.toDate() - a.lastVisit.toDate(); return 0; });
        const listEl = document.getElementById('playerList');
        if (playerList.length === 0) { listEl.innerHTML = '<p style="color:#9ca3af;text-align:center">No players yet</p>'; } 
        else {
            listEl.innerHTML = playerList.slice(0, 50).map(p => {
                const lastVisit = p.lastVisit && p.lastVisit.toDate ? p.lastVisit.toDate().toLocaleString('id-ID') : 'Unknown';
                const status = p.isOnline ? 'Online' : 'Offline';
                const statusClass = p.isOnline ? 'status-online' : 'status-offline';
                return `<div class="player-item"><div class="player-info"><div class="player-id">${p.playerId || p.id}</div><div class="player-game">${p.game || 'CleanArcade'} • ${lastVisit}</div></div><div class="player-status ${statusClass}">${status}</div></div>`;
            }).join('');
        }
    }).catch(err => { console.error('Error:', err); document.getElementById('playerList').innerHTML = '<p style="color:#ff4757;text-align:center">Error loading data</p>'; });
}
document.getElementById('adminOverlay').addEventListener('click', (e) => { if (e.target === document.getElementById('adminOverlay')) closeAdmin(); });
</script>
</body>
</html>
